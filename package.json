{
  "name": "kartly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "lint": "next lint",
